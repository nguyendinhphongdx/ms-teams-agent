PORT=3978

# --- Bot credentials ---
# Để TRỐNG khi test local với Agents Playground (bỏ qua xác thực JWT).
# Điền khi chạy với Teams thật (lấy từ Teams Developer Portal > Bot management).
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# --- AI ---
# Lấy key tại https://aistudio.google.com/apikey
# Để trống thì bot chạy chế độ "echo" (không gọi LLM) để test luồng Teams trước.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tuỳ chọn: trỏ qua proxy/gateway nội bộ. Để trống = endpoint mặc định của Google.
GEMINI_BASE_URL=

# --- API gửi tin vào Teams: POST /api/notify ---
# Hệ thống khác gọi API phải gửi header "x-api-key: <giá trị này>".
# Để trống: dev thì cho qua (để test), production thì API bị khoá.
NOTIFY_API_KEY=

# --- Tuỳ chọn ---
# Tên bot hiện trong trang quản trị (/). Không liên quan tên bot trong Teams/Playground.
BOT_DISPLAY_NAME=CMC Assistant
# Nơi lưu "địa chỉ" các channel/chat bot đã biết. Mặc định data/conversations.json.
# Production nhiều replica: đổi sang DB/Redis (xem phần cuối README.md).
CONVERSATION_STORE_FILE=
